# Copia este archivo a .env (no se sube a git) y ajusta los valores.
DB_URL=jdbc:postgresql://localhost:5432/soundia_db
DB_USERNAME=soundia_user
DB_PASSWORD=pon-aqui-tu-contrasena

# Autenticacion del API (apagada por defecto). Para encenderla, pon SOUNDIA_AUTH_ENABLED=true y rellena las tres
# siguientes; con ella encendida y alguna vacia la aplicacion no arranca. La clave de firma: 32 o mas caracteres
# aleatorios (por ejemplo: openssl rand -base64 48). No las subas a git.
SOUNDIA_AUTH_ENABLED=false
SOUNDIA_AUTH_USERNAME=
SOUNDIA_AUTH_PASSWORD=
SOUNDIA_AUTH_JWT_SECRET=

# Solo para docker compose (ver docker-compose.yml): clave secreta del motor de IA (Django).
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Produccion (docker-compose.prod.yml): todas obligatorias. DOMAIN es el dominio sin https:// (por ejemplo dj.midominio.com).
# El login se enciende solo; usa una contrasena larga y una clave de firma aleatoria de 32 o mas caracteres.
DOMAIN=
